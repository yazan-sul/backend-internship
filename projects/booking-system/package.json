{
  "name": "booking-system",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "predev": "bun install",
    "dev": "bun run scripts/dev.ts",
    "build": "bun run --cwd frontend build && dotnet build backend/AirportTicketBookingSystem.csproj",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --cwd frontend tsc -b --pretty false",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "test:backend": "dotnet test backend.Tests/AirportTicketBookingSystem.Tests.csproj --filter FullyQualifiedName!~DatabaseIntegrationTests",
    "test:backend:integration": "RUN_DATABASE_INTEGRATION_TESTS=1 dotnet test backend.Tests/AirportTicketBookingSystem.Tests.csproj --filter FullyQualifiedName~DatabaseIntegrationTests",
    "test": "bun test && bun run test:backend"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "latest"
  }
}
